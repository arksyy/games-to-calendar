# Team to select in the B2 schedule (as shown on the DDLC website)
TEAM_NAMES=L'Antichambre
CATEGORY=B2 (Interligue)

# Season label to select on the DDLC calendar page.
# Must match exactly the dropdown option.
SEASON=Adulte | Automne/Hiver 2026-2027

# F6+ profile (run with: ./run.sh gab). Uses the same season above.
GAB_TEAM_NAMES=L’Antichambre
GAB_CATEGORY=F6+ (Saint-Aug)
GAB_CALENDAR_STAUG=Dek St-Aug GAB
GAB_CALENDAR_CHAUVEAU=Dek Chauveau GAB
